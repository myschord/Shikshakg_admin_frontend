# NEXT_PUBLIC_* values are baked into the static build. Set them as build variables in the Cloudflare project.

# Origin of the Shikshag backend (no trailing slash, no /api/v1). Local stack: http://localhost:8020
NEXT_PUBLIC_API_URL=https://api.example.com

NEXT_PUBLIC_APP_ENV=production

# The users, action log, announcements, current affairs and daily quiz screens use sample data in the browser
# until the backend has their routes (see docs/BACKEND_NEEDS.md). Set to false when it does.
NEXT_PUBLIC_USE_MOCKS=true
